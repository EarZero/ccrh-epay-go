# 复制为 .env 后再修改；不要把真实密钥提交到代码仓库。

# 已构建的 linux/amd64 应用镜像
BACKEND_IMAGE=ai-city-cn-shanghai.cr.volces.com/ccrh/ccrh-epay-gateway:20260922-registration-closed-backend
FRONTEND_IMAGE=ai-city-cn-shanghai.cr.volces.com/ccrh/ccrh-epay-gateway:20260922-registration-closed-frontend

# PostgreSQL
DB_USER=epay
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=epay

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT：请改成长度足够的随机字符串
JWT_SECRET=CHANGE_ME_JWT_SECRET

# 首次启动且数据库没有管理员时创建；已有管理员不会被覆盖
DEFAULT_ADMIN_USERNAME=epay_admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 生产环境关闭商户公开注册；商户由管理端“商户管理 -> 新增商户”创建
MERCHANT_REGISTRATION_ENABLED=false
