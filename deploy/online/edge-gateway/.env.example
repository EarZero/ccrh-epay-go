# 复制为 .env 后再修改；不要把真实配置提交到代码仓库。

# Caddy 对外使用正式标准端口。只有 Caddy 暴露宿主机端口。
HTTP_PORT=80
HTTPS_PORT=443

# EPay 站点域名：DNS A/AAAA 记录需要指向本服务器。
PAY_SITE_ADDRESS=http://epay-ccrh.glgtjt.com

# 预留域名：服务上线后再加入 Caddy 路由，当前不启用。
# ROUTER_SITE_ADDRESS=http://router-ccrh.glgtjt.com
# XIAOGU_SITE_ADDRESS=http://xiaogu-ccrh.glgtjt.com
